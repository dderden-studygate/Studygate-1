{
  "name": "Study Gate",
  "short_name": "Study Gate",
  "description": "Shareable child and parent quiz app with local progress tracking and outbox support.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#1f1c2c",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "./icons/studygate-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/studygate-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/studygate-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
